#compdef jssh

_jssh() {
  local -a commands hosts accounts
  commands=(
    'ssh:Open SSH through KoKo'
    'sftp:Open interactive SFTP'
    'connect:Interactive asset selector'
    'list:Print cached assets'
    'recent:Print recent connections'
    'sync:Refresh granted assets'
    'doctor:Check config and binaries'
    'config:Show non-secret config'
    'totp:Print the current TOTP code'
    'secrets:Store AK/SK and TOTP'
    'cache:Cache operations'
    'complete:Print cache tokens for completion'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'command' commands
    return
  fi

  case ${words[2]} in
    ssh|sftp)
      if [[ ${words[CURRENT - 1]} == --account ]]; then
        local host=""
        integer i
        for (( i = 3; i < CURRENT; i++ )); do
          case ${words[i]} in
            --account|--last) continue ;;
            -*) continue ;;
            *) host=${words[i]}; break ;;
          esac
        done
        accounts=(${(f)"$(jssh complete account ${host} 2>/dev/null)"})
        (( ${#accounts} )) && _values 'account' $accounts
        return
      fi
      if [[ ${words[CURRENT]} == -* ]]; then
        _values 'option' '--account' '--last'
        return
      fi
      hosts=(${(f)"$(jssh complete host 2>/dev/null)"})
      (( ${#hosts} )) && _values 'host' $hosts
      ;;
  esac
}

_jssh "$@"
